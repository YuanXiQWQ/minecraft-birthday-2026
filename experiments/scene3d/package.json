{
  "name": "minecraft-birthday-p2-scene3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:built": "node --test tests/built.test.mjs",
    "build": "npm run check && vite build && node tools/audit-build.mjs dist",
    "build:subpath": "vite build --base=/minecraft-birthday-2026/ --outDir=../dist-subpath && node tools/audit-build.mjs dist-subpath",
    "preview": "vite preview --host 127.0.0.1",
    "preview:subpath": "vite preview --host 127.0.0.1 --port 4179 --outDir ../dist-subpath --base /minecraft-birthday-2026/",
    "probe:models": "node tools/probe-models.ts"
  },
  "dependencies": { "three": "0.186.1" },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
