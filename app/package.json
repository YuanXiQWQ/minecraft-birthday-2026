{
  "name": "minecraft-birthday-2026",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "npm run check && vite build && node tools/audit-build.mjs dist",
    "build:pages": "vite build --base=/minecraft-birthday-2026/ --outDir=../dist-pages && node tools/audit-build.mjs dist-pages",
    "preview": "vite preview --host 127.0.0.1",
    "preview:pages": "vite preview --host 127.0.0.1 --port 4186 --outDir ../dist-pages --base /minecraft-birthday-2026/",
    "dev:verify": "vite --mode verification --host 127.0.0.1 --port 4184",
    "test:built": "node --test tests/built.test.mjs",
    "data:export": "node tools/export-vanilla.ts",
    "data:verify": "node tools/verify-vanilla.ts"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
